Z = "Z_against_both"

# A Monday. ISO week 2 of 2026 (week 1 is 29 Dec 2025 to 4 Jan 2026).
ENTRY = "2026-01-05 12:00"


def week(i, k=20):
    """k different week labels, cycling. 15 or more weeks means clustering is used."""
    return f"2026-W{(i % k) + 1:02d}"


def row(label, room_r, run_r, stopped, risk=2.0, entry_time=ENTRY,
        direction="LONG", stop=100.0):
    return {
        "label": label,
        "room_r": room_r,
        "run_r": run_r,
        "stopped": stopped,
        "risk": risk,
        # resolved_trades() builds the week label from entry_time
        "entry_time": pd.Timestamp(entry_time),
        "direction": direction,
        "stop": stop,
    }


def trade(net, z, room, win=None, wk="2026-W02", risk=2.0):
    # pooled_effects() clusters by "week" and optionally controls for "risk"
    return {
        "net": net,
        "z": z,
        "room": room,
        "win": net > 0 if win is None else win,
        "week": wk,
        "risk": risk,
    }


# ---------------------------------------------------------------- room_passes

def test_room_passes_boundary_and_missing_swing():
    assert zr.room_passes(1.5, 1.5)
    assert zr.room_passes(2.0, 1.5)
    assert not zr.room_passes(1.49, 1.5)
