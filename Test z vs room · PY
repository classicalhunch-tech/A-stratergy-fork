# ------------------------------------------------------------------ week_label

def test_week_label_is_iso_year_and_week():
    assert zr.week_label("2026-01-05") == "2026-W02"
    assert zr.week_label("2025-12-29") == "2026-W01"  # ISO year differs from calendar year
    assert zr.week_label(pd.Timestamp("2026-01-11 23:55")) == "2026-W02"  # Sunday


# ----------------------------------------------------------------- dedupe_rows

def test_dedupe_rows_drops_only_true_repeats():
    a = row("A", 1.0, 0.5, True, stop=99.00001)
    same = dict(a, stop=99.00004)                          # equal to 4 decimals
    other_direction = dict(a, direction="SHORT")
    other_stop = dict(a, stop=98.0)
    other_time = dict(a, entry_time=pd.Timestamp("2026-01-05 13:00"))

    kept, dropped = zr.dedupe_rows(
        [a, same, other_direction, other_stop, other_time]
    )

    assert dropped == 1
    assert len(kept) == 4
    assert kept[0] is a


# ------------------------------------------------------------ resolved_trades

def test_resolved_trades_net_of_cost_and_censoring():
    rows = [
        row(Z, 3.0, run_r=2.5, stopped=False),     # target hit: +2R
        row("A_counter_trend", 1.0, run_r=0.5, stopped=True),  # stop: -1R
        row("B_with_trend", 1.0, run_r=0.5, stopped=False),    # open: dropped
    ]

    out = zr.resolved_trades(rows, target=2.0, cost=0.5)

    assert len(out) == 2

    # cost 0.5 / risk 2.0 = 0.25R
    assert out[0]["net"] == pytest.approx(2.0 - 0.25)
    assert out[0]["win"] and out[0]["z"]
    assert out[1]["net"] == pytest.approx(-1.0 - 0.25)
    assert not out[1]["win"] and not out[1]["z"]

    # every resolved trade carries its ISO week, for clustering
    assert out[0]["week"] == "2026-W02"
    assert out[1]["week"] == "2026-W02"


def test_resolved_trades_carries_split_keys():
    r = dict(row(Z, 3.0, run_r=2.5, stopped=False),
             quarter="2026Q1", window="head")

    out = zr.resolved_trades([r], target=2.0, cost=0.5)

    assert out[0]["quarter"] == "2026Q1"
    assert out[0]["direction"] == "LONG"
    assert out[0]["window"] == "head"


# ----------------------------------------------------------------- cell_stats

def test_cell_stats_and_empty_cell():
    n, win, mean, se = zr.cell_stats(
        [trade(1.0, True, 2.0), trade(-1.0, True, 2.0), trade(3.0, True, 2.0)]
    )

    assert n == 3
    assert win == pytest.approx(100.0 * 2 / 3)
    assert mean == pytest.approx(1.0)
    assert se == pytest.approx(math.sqrt(4.0 / 3))  # sample SD 2, n 3

    n, win, mean, se = zr.cell_stats([])
    assert n == 0 and win != win and mean != mean


# ----------------------------------------------------------------- welch_diff

def test_welch_diff_known_values():
    a = (10, 50.0, 1.0, 0.3)
    b = (12, 40.0, 0.4, 0.4)

    diff, se, t = zr.welch_diff(a, b)

    assert diff == pytest.approx(0.6)
    assert se == pytest.approx(0.5)
    assert t == pytest.approx(1.2)


def test_welch_diff_needs_two_trades_in_each_cell():
    one = (1, 100.0, 1.0, float("nan"))
    ok = (10, 50.0, 0.0, 0.2)

    for pair in ((one, ok), (ok, one), ((0, float("nan"), float("nan"), float("nan")), ok)):
        diff, se, t = zr.welch_diff(*pair)
        assert diff != diff and t != t


def test_welch_diff_min_n_blocks_tiny_cells():
    tiny = (3, 0.0, -1.0, 0.01)   # 3 losers in a row: SE near zero
    big = (30, 50.0, 0.2, 0.15)

    assert zr.welch_diff(tiny, big)[2] == zr.welch_diff(tiny, big)[2]  # default allows it
    assert zr.welch_diff(tiny, big, min_n=8)[0] != zr.welch_diff(tiny, big, min_n=8)[0]
    assert zr.welch_diff(big, big, min_n=8)[0] == pytest.approx(0.0)


# ------------------------------------------------------------------ ols_robust

def test_clustered_se_equals_hc1_when_every_trade_is_its_own_cluster():
    rng = np.random.default_rng(1)
    n = 60
    X = np.column_stack(
        [np.ones(n), rng.integers(0, 2, n), rng.integers(0, 2, n)]
    ).astype(float)
    y = rng.normal(size=n)

    b_hc, se_hc = zr.ols_robust(X, y, None)
    b_cl, se_cl = zr.ols_robust(X, y, list(range(n)))

    assert np.allclose(b_hc, b_cl)
    assert np.allclose(se_hc, se_cl)


# ------------------------------------------------------------- pooled_effects

def test_pooled_effects_recovers_known_coefficients():
    rng = np.random.default_rng(7)
    trades = []

    for i in range(400):
        z = bool(rng.integers(0, 2))
        passes = bool(rng.integers(0, 2))
        room = 3.0 if passes else 0.5
        net = -0.2 + 0.5 * z + 1.0 * passes + rng.normal(0, 0.3)
        trades.append(trade(net, z, room, wk=week(i)))

    out = zr.pooled_effects(trades, threshold=1.5)

    assert out["z"][0] == pytest.approx(0.5, abs=0.1)
    assert out["room"][0] == pytest.approx(1.0, abs=0.1)
    assert out["z"][1] > 0 and out["room"][1] > 0
    assert out["clusters"] == 20 and out["note"] is None

    # same coefficients as plain least squares
    X = np.column_stack(
        [
            np.ones(len(trades)),
            [1.0 if t["z"] else 0.0 for t in trades],
            [1.0 if zr.room_passes(t["room"], 1.5) else 0.0 for t in trades],
        ]
    )
    y = np.array([t["net"] for t in trades])
    beta = np.linalg.lstsq(X, y, rcond=None)[0]

    assert out["z"][0] == pytest.approx(beta[1])
    assert out["room"][0] == pytest.approx(beta[2])


def test_pooled_effects_not_estimable_when_a_factor_never_varies():
    only_z = [trade(float(i), True, 3.0) for i in range(10)]
    assert zr.pooled_effects(only_z, 1.5) is None

    no_pass = [trade(float(i), i % 2 == 0, 0.5) for i in range(10)]
    assert zr.pooled_effects(no_pass, 1.5) is None

    assert zr.pooled_effects([trade(1.0, True, 3.0)] * 3, 1.5) is None


def test_week_clustering_widens_the_se_when_trades_in_a_week_move_together():
    # Z is decided per week, and each week has its own shared shock, so the
    # trades inside a week are not independent. Trade-level SEs are too small.
    rng = np.random.default_rng(3)
    trades = []

    for w in range(30):
        shock = rng.normal(0, 1.0)
        z = w % 2 == 0

        for _ in range(10):
            passes = bool(rng.integers(0, 2))
            net = shock + 0.3 * passes + rng.normal(0, 0.3)
            trades.append(
                trade(net, z, 3.0 if passes else 0.5, wk=f"2026-W{w + 1:02d}")
            )

    hc = zr.pooled_effects(trades, 1.5, cluster=False)
    cl = zr.pooled_effects(trades, 1.5, cluster=True)

    assert cl["clusters"] == 30
    assert cl["z"][1] > 1.5 * hc["z"][1]
    # coefficients themselves do not change, only the SE
    assert cl["z"][0] == pytest.approx(hc["z"][0])


def test_clustering_falls_back_to_hc1_with_too_few_weeks():
    trades = [
        trade(float(i % 3), i % 2 == 0, 3.0 if i % 3 else 0.5, wk=week(i, k=5))
        for i in range(60)
    ]

    out = zr.pooled_effects(trades, 1.5, cluster=True)
    hc = zr.pooled_effects(trades, 1.5, cluster=False)

    assert out["clusters"] is None
    assert "HC1" in out["note"]
    assert out["z"] == hc["z"] and out["room"] == hc["room"]


def test_stop_size_control_removes_a_room_effect_that_is_really_stop_size():
    # Net R depends only on the stop size. Room (in R) is high when the stop is
    # tight, so without the control "room" looks like a big effect.
    rng = np.random.default_rng(5)
    trades = []

    for i in range(400):
        tight = bool(rng.integers(0, 2))
        risk = float(rng.uniform(1.0, 2.0) if tight else rng.uniform(3.0, 5.0))
        passes = tight if rng.random() < 0.85 else (not tight)
        net = -math.log(risk) + rng.normal(0, 0.3)
        trades.append(
            trade(net, bool(rng.integers(0, 2)), 3.0 if passes else 0.5,
                  wk=week(i), risk=risk)
        )

    plain = zr.pooled_effects(trades, 1.5, cluster=False)
    ctrl = zr.pooled_effects(trades, 1.5, cluster=False, control=True)

    assert plain["room"][0] > 0.5
    assert abs(ctrl["room"][0]) < 0.15


# -------------------------------------------------------------------- verdict

@pytest.mark.parametrize(
    "t_z,t_rz,t_rn,expected",
    [
        (3.0, 0.5, 0.5, "Z is the edge"),
        (3.0, 0.5, 2.5, "BOTH"),
        (0.5, 2.5, 2.5, "ROOM is the edge"),
        (0.5, 0.5, 2.5, "room leans"),
        (0.5, 0.5, 0.5, "NEITHER"),
        (float("nan"), float("nan"), float("nan"), "NEITHER"),
        (-3.0, -3.0, -3.0, "NEITHER"),  # a large NEGATIVE t is not evidence for
    ],
)
def test_verdict(t_z, t_rz, t_rn, expected):
    assert expected in zr.verdict(t_z, t_rz, t_rn, crit=2.0)


# ------------------------------------------------------ significant_notes / flips

def test_significant_notes_reports_both_directions():
    pooled = {"z": (-0.4, 0.2), "room": (0.1, 0.5)}  # t -2.0 (not > 2), +0.2

    notes = zr.significant_notes(
        {"a": -3.16, "b": 1.5, "c": float("nan"), "d": 2.4}, pooled, crit=1.9
    )

    assert notes == ["a t -3.16", "d t +2.40", "pooled Z effect t -2.00"]
    assert zr.significant_notes({"a": 0.1}, None, crit=2.0) == []


def test_sign_flips_detects_each_effect_separately():
    head = {"z": (-0.4, 0.2), "room": (-0.1, 0.2)}
    tail = {"z": (0.3, 0.2), "room": (0.4, 0.2)}

    assert zr.sign_flips(head, tail) == ["Z", "room"]
    assert zr.sign_flips(tail, tail) == []
    assert zr.sign_flips({"z": (0.3, 0.2), "room": (-0.1, 0.2)}, tail) == ["room"]
    assert zr.sign_flips(None, tail) == []


# ------------------------------------------------- room uses the real swing

T0 = pd.Timestamp("2026-01-05 12:00")
H = pd.Timedelta(hours=1)


def test_tiny_min_rr_returns_nearest_swing_whatever_its_distance():
    swings = [
        Swing(SwingType.HIGH, 100.5, T0 - 2 * H - H, T0 - 2 * H),
        Swing(SwingType.HIGH, 110.0, T0 - H - H, T0 - H),
    ]

    # risk 4: nearest swing is 0.125R away
    room_fn = StructureTargets(
        swings, StructureTargetConfig(min_rr=zr.TINY_MIN_RR)
    ).target

    price = room_fn(SignalType.LONG, 100.0, 96.0, T0)

    assert price == 100.5
    assert abs(price - 100.0) / 4.0 == pytest.approx(0.125)

    # the spec's rule would have skipped it
    skip_fn = StructureTargets(swings).target
    assert skip_fn(SignalType.LONG, 100.0, 96.0, T0) is None


def test_room_function_is_causal_like_the_exit():
    swings = [Swing(SwingType.LOW, 90.0, T0, T0 + H)]  # not yet confirmed

    room_fn = StructureTargets(
        swings, StructureTargetConfig(min_rr=zr.TINY_MIN_RR)
    ).target

    assert room_fn(SignalType.SHORT, 100.0, 102.0, T0) is None
