# Python environment and cache (rebuilt on any machine)
.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Secrets, never upload these
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Databases (back up separately)
*.db
*.sqlite
*.sqlite3
*.db.bak
*.parquet
*.feather

# Big data files (back up separately)
