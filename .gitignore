# real MT5 gold export can be committed and tested by CI.
your_data_file*.csv
gold_orderflow/data/
market_data/data/
orderflow/market_data/data/

# Logs and runtime files
/logs/
*.log
*.pid
*.tmp
*.temp

# Backups and temporary files
*.bak
*.bak2
*.bak3

# Generated outputs
mtf_trades_*.csv
orderflow_research.csv
diagnosis_output.txt
core_strategy_dump.txt

# State and runtime directories
/state/

