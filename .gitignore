# Python environment and cache (rebuilt on any machine)
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Secrets, never upload these
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Databases (back up separately)
*.db
*.sqlite
*.sqlite3
*.db.bak
*.parquet
*.feather

# Big data files (back up separately)
real_gold_data*.csv
your_data_file*.csv
gold_orderflow/data/
market_data/data/
orderflow/market_data/data/

# Logs and runtime files
*.log
logs/
*.pid
*.tmp
*.temp

# Editor and OS junk
.vscode/
.idea/
.DS_Store
Thumbs.db